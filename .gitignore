# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej
.#*
\#*\#
.DS_Store

# Flutter's local SwiftPM shim links to the installed SDK and is not portable.
/packages/flutter_realtime_chat_ivs/ios/FlutterFramework/Flutter.xcframework
/packages/flutter_realtime_media_ivs/ios/FlutterFramework/Flutter.xcframework
# The iOS launch helper creates additional FlutterFramework shim directories
# with machine-specific Flutter.xcframework symlinks. Do not commit them.
/packages/*/ios/FlutterFramework/
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
packages/*/pubspec.lock
**/doc/api/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/dist/
.build/
.swiftpm/
.gradle/
**/.cxx/
coverage/
.widget_preview/
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/ios/**/xcuserdata/
*.xcuserstate

# Local-only toolchains and runtime state: livekit-server binary, Go caches,
# pid/log files. Safe to delete at any time; never committed.
.local/

# Local agent tooling state (plans, sessions, generated metadata)
.zcode/

# Agent prompts & skills (local only, never commit)
# AGENTS.md 是项目级提示词注入，保持跟踪，不在这里忽略
prompts/
.prompts/
prompt/
.prompt/
skills/
.skills/
.local-prompts/
.ai-prompts/
.claude/
.cursor/
.codex/
.aider*/
.agents/
.agent/
.coding-tools/
CLAUDE.local.md
GEMINI.local.md


node_modules/
/example/web/provider_bridge/dist/
/tool/provider_web_assets/dist/

# flutter_realtime_video_effects commits its generated Web bundle under
# assets/web/ on purpose (same convention as packages/flutter_realtime_sdk).
# What stays out of git is the plugin's `flutter create` template example
# (the demo app lives in /example) and package-level .metadata, which the
# Flutter tooling regenerates on demand.
/packages/flutter_realtime_video_effects/example/
/packages/*/.metadata

# Local demo-server credentials (keep .env.example reviewable if added later).
/demo-server/.env
/demo-server/.env.*
!/demo-server/.env.example
/demo-server/.provider-state.json
.vercel

# Generated Flutter scaffolding (flutter run/create outputs, never commit).
# Workspace root is a Dart tooling package, not a Flutter app: android/app,
# ios/Runner, linux/flutter, macos/Flutter here are accidental tool outputs.
# example/devtools_options.yaml is a local DevTools state file.
**/GeneratedPluginRegistrant.java
**/Flutter/GeneratedPluginRegistrant.swift
**/Runner/GeneratedPluginRegistrant.h
**/Runner/GeneratedPluginRegistrant.m
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/Flutter/ephemeral/
**/linux/flutter/generated_*
**/android/local.properties
# Local Docs (personal verification notes, scan reports, filled acceptance
# records). doc/ stays tracked and shared; doc-local/ never commits.
# Note: doc/OPTIMIZATION_VALIDATION.md was moved to doc-local/ and untracked
# via `git rm --cached` (gitignore alone does not cover tracked files).
/doc-local/
/docs/history-session/
doc/acceptance-record.*.local.json
**/devtools_options.yaml
